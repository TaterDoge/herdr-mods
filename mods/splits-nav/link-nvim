#!/bin/sh
# Installs this mod's nvim half: links nvim/plugin/herdr-nav.lua into
# stdpath("config")/plugin so nvim loads it at startup. Run by the agent while
# installing the mod — not by the user, and never through a plugin manager.
# The linked file resolves the symlink to find its own folder and puts it on
# runtimepath, so there is no nvim config to edit.
# Restart nvim afterwards. Idempotent; a real file in the way is left alone.
set -eu
here="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
src="$here/nvim/plugin/herdr-nav.lua"
config_dir="${NVIM_CONFIG_DIR:-$(nvim --headless --clean -c 'lua io.stdout:write(vim.fn.stdpath("config"))' -c 'q' 2>/dev/null)}"
if [ -z "$config_dir" ]; then
  echo "cannot read stdpath('config'); set NVIM_CONFIG_DIR" >&2
  exit 1
fi
dest="${NVIM_PLUGIN_DIR:-$config_dir/plugin}/herdr-nav.lua"

mkdir -p "$(dirname -- "$dest")"
if [ -L "$dest" ]; then
  if [ "$(readlink "$dest")" = "$src" ]; then
    echo "already linked: $dest -> $src"
    echo "restart nvim to load herdr-nav"
    exit 0
  fi
  # stale link from a checkout that has since moved
  rm -f "$dest"
elif [ -e "$dest" ]; then
  echo "skip: $dest exists and is not a symlink; remove it first" >&2
  exit 1
fi
ln -s "$src" "$dest"
echo "linked: $dest -> $src"
echo "restart nvim to load herdr-nav"
