#!/bin/sh
# Link every mod here into the app's config, so edits hot-reload in the window.
# One folder per run: herdr docks a mod the first time it sees its folder.
set -e
repo=$(cd "$(dirname "$0")/.." && pwd)
target="$HOME/.config/herdr-app/mods"
mkdir -p "$target"
for dir in "$repo"/mods/*/; do
  name=$(basename "$dir")
  if [ -e "$target/$name" ] && [ ! -L "$target/$name" ]; then
    echo "skip $name: $target/$name exists and is not a symlink"
    continue
  fi
  ln -sfn "$dir" "$target/$name"
  echo "linked $name"
done